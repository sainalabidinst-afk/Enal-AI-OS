.:53 {
    # CoreDNS configuration for Enal AI OS
    # Forwards queries to upstream resolvers for external names
    forward . /etc/resolv.conf 8.8.8.8 1.1.1.1
    log . "{remote} - {>id} \"{type} {class} {name} {proto} {size} {>do} {>bufdo} - {rcode} {>rflags} {rsize {>duration}\""
    errors
    health
    prometheus 0.0.0.0:8053
    loop
    reload
    cache 300
}

enal.ai:53 {
    # Internal zone for Enal AI OS services
    # Forward to Docker's embedded DNS for container name resolution
    forward . 127.0.0.11
    log . "{remote} - {>id} \"{type} {class} {name} {proto} {size} - {rcode} {>duration}\""
    errors
    health
    prometheus 0.0.0.0:8053
    cache 30
    reload
    loop
    bind 0.0.0.0
}

local. {
    # Local development zone
    forward . /etc/resolv.conf
    log
    errors
    health
}
