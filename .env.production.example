# Production Environment Configuration for Enal AI OS
# ============================================================================
# IMPORTANT: This file is a TEMPLATE. Copy to .env.production and fill with
# real secrets. NEVER commit .env.production to version control.
# Generated: 2026-10-02
# Target Release: v3.0.0

# ----------------------------------------------------------------------------
# Core
# ----------------------------------------------------------------------------
PROJECT_NAME=Enal AI OS
VERSION=3.0.0
API_V1_STR=/api/v1

# ----------------------------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------------------------
POSTGRES_PASSWORD=                        # REQUIRED: Set a strong password
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/enal_ai_os

# ----------------------------------------------------------------------------
# Redis (caching, rate limiting, session store)
# ----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ----------------------------------------------------------------------------
# Qdrant (vector embeddings store)
# ----------------------------------------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=                           # REQUIRED if Qdrant auth enabled

# ----------------------------------------------------------------------------
# Object Storage (MinIO / S3 compatible)
# ----------------------------------------------------------------------------
MINIO_ROOT_USER=                          # REQUIRED: MinIO root user
MINIO_ROOT_PASSWORD=                      # REQUIRED: MinIO root password (min 8 chars)
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=enal
MINIO_SECURE=false

# ----------------------------------------------------------------------------
# Kafka (message broker / event streaming)
# ----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ----------------------------------------------------------------------------
# LLM Provider Configuration (LiteLLM)
# ----------------------------------------------------------------------------
# LiteLLM is the unified LLM routing layer. At least one provider MUST be
# configured for runtime benchmarks to function. If no provider key is set,
# the benchmark suite will emit "BENCHMARK BLOCKED" and not fabricate results.
#
# Provider Priority Order (first available is used for DEFAULT_MODEL):
#   1. OpenAI GPT-4o / o1
#   2. Anthropic Claude
#   3. Google Gemini
#   4. Ollama (local)
#   5. LM Studio (local)

# --- OpenAI ---
OPENAI_API_KEY=                           # REQUIRED for OpenAI provider

# --- Anthropic ---
ANTHROPIC_API_KEY=                        # REQUIRED for Anthropic provider

# --- Google ---
GOOGLE_API_KEY=                           # Alternative to GEMINI_API_KEY
GEMINI_API_KEY=                           # Preferred for Gemini models

# --- Ollama (local LLM runtime) ---
OLLAMA_BASE_URL=http://ollama:11434

# --- LM Studio (local inference server for Docker Desktop) ---
LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
LM_STUDIO_API_KEY=lm-studio

# --- LiteLLM Master Key (for LiteLLM proxy mode, optional) ---
LITELLM_MASTER_KEY=                       # Set if running LiteLLM in proxy mode

# --- Model Selection ---
# Production default: use a cloud provider for quality. Change to ollama/ or
# lmstudio/ prefix only for local/offline deployments.
DEFAULT_MODEL=gpt-4o
DEFAULT_REASONING_MODEL=gpt-4o
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# --- Model Parameters ---
MAX_TOKENS=4096
TEMPERATURE=0.7

# ----------------------------------------------------------------------------
# Security
# ----------------------------------------------------------------------------
SECRET_KEY=                               # REQUIRED: Strong secret (32+ chars), rotate periodically
ACCESS_TOKEN_EXPIRE_MINUTES=480          # 8 hours — shorter for production

# ----------------------------------------------------------------------------
# Observability (Langfuse / LangChain tracing)
# ----------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=enal-ai-os

LANGFUSE_SECRET_KEY=                      # REQUIRED for production observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=http://langfuse:3000

# --- Structured Logging (JSON to stdout for log aggregation) ---
LOG_LEVEL=INFO
LOG_FORMAT=json
LOGGING_PROVIDER=console                  # Options: console, loki, elk, datadog

# --- Health Check ---
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_TIMEOUT_MS=5000

# ----------------------------------------------------------------------------
# Feature Flags
# ----------------------------------------------------------------------------
TESTING=false
DEBUG=false
ENABLE_BENCHMARK_RUNTIME=true            # Enable runtime benchmark execution
RUNTIME_BENCHMARK_TIMEOUT_SECONDS=300

# ----------------------------------------------------------------------------
# Consent & Permissions
# ----------------------------------------------------------------------------
CONSENT_REQUIRED_FOR_SENSITIVE_ACTIONS=true
CONSENT_RETENTION_HOURS=24

# ----------------------------------------------------------------------------
# Jenny Voice — Sexy & Bratty (manja) personality
# ----------------------------------------------------------------------------
TTS_PROVIDER=elevenlabs
TTS_VOICE=en
TTS_VOICE_NAME=Jenny-SexyBrat
TTS_VOICE_GENDER=female
TTS_VOICE_TONE=sexy
TTS_VOICE_ATTITUDE=bratty
TTS_SPEED=0.85                            # Slower for sultry delivery
TTS_ELEVENLABS_VOICE_ID=2E0E83F1-1B49-4C73-9D92-A6C6E9A9A9A5
JENNY_VOICE_PROFILE=jenny
JENNY_TTS_VOICE_ID=2E0E83F1-1B49-4C73-9D92-A6C6E9A9A9A5
JENNY_LANGUAGE=id
TTS_PITCH=1.25                            # Higher pitch for feminine tone
TTS_EMPHASIS=1.4                          # Emphasize key words
TTS_PAUSE_SCALE=1.2                       # Longer pauses between phrases
TTS_STYLE_EXAGGERATION=0.85               # More expressive personality
TTS_STABILITY=0.35                        # Lower = more dynamic voice
TTS_SIMILARITY_BOOST=0.85
