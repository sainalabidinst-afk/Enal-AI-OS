{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Platform Certificate",
  "description": "Final platform-level certification artifact for ENAL AI OS.",
  "type": "object",
  "required": [
    "platform",
    "version",
    "coreCertified",
    "capabilitiesCertified",
    "coreAudit",
    "crossCapabilityAudit",
    "runtimeAudit",
    "endToEndAudit",
    "operationalAudit",
    "auditScore",
    "benchmarkScore",
    "productionReadinessScore",
    "platformCertified",
    "certificationDate",
    "reviewer",
    "certificateLevel"
  ],
  "properties": {
    "platform": {
      "type": "string",
      "example": "ENAL AI OS"
    },
    "version": {
      "type": "string",
      "example": "1.0.0"
    },
    "coreCertified": {
      "type": "boolean"
    },
    "capabilitiesCertified": {
      "type": "integer",
      "minimum": 0
    },
    "coreAudit": {
      "type": "object",
      "required": ["score", "maxScore", "percentage", "passed", "findings"],
      "properties": {
        "score": {
          "type": "number"
        },
        "maxScore": {
          "type": "number"
        },
        "percentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "passed": {
          "type": "boolean"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["severity", "description", "component"],
            "properties": {
              "severity": {
                "type": "string",
                "enum": ["Critical", "Major", "Minor", "Info"]
              },
              "description": {
                "type": "string"
              },
              "component": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "crossCapabilityAudit": {
      "type": "object",
      "required": ["score", "maxScore", "percentage", "passed", "findings"],
      "properties": {
        "score": {
          "type": "number"
        },
        "maxScore": {
          "type": "number"
        },
        "percentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "passed": {
          "type": "boolean"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["severity", "description", "component"],
            "properties": {
              "severity": {
                "type": "string",
                "enum": ["Critical", "Major", "Minor", "Info"]
              },
              "description": {
                "type": "string"
              },
              "component": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "runtimeAudit": {
      "type": "object",
      "required": ["score", "maxScore", "percentage", "passed", "findings"],
      "properties": {
        "score": {
          "type": "number"
        },
        "maxScore": {
          "type": "number"
        },
        "percentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "passed": {
          "type": "boolean"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["severity", "description", "component"],
            "properties": {
              "severity": {
                "type": "string",
                "enum": ["Critical", "Major", "Minor", "Info"]
              },
              "description": {
                "type": "string"
              },
              "component": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "endToEndAudit": {
      "type": "object",
      "required": ["score", "maxScore", "percentage", "passed", "findings"],
      "properties": {
        "score": {
          "type": "number"
        },
        "maxScore": {
          "type": "number"
        },
        "percentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "passed": {
          "type": "boolean"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["severity", "description", "component"],
            "properties": {
              "severity": {
                "type": "string",
                "enum": ["Critical", "Major", "Minor", "Info"]
              },
              "description": {
                "type": "string"
              },
              "component": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "operationalAudit": {
      "type": "object",
      "required": ["score", "maxScore", "percentage", "passed", "findings"],
      "properties": {
        "score": {
          "type": "number"
        },
        "maxScore": {
          "type": "number"
        },
        "percentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "passed": {
          "type": "boolean"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["severity", "description", "component"],
            "properties": {
              "severity": {
                "type": "string",
                "enum": ["Critical", "Major", "Minor", "Info"]
              },
              "description": {
                "type": "string"
              },
              "component": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "auditScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "benchmarkScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "productionReadinessScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "platformCertified": {
      "type": "boolean"
    },
    "certificationDate": {
      "type": "string",
      "format": "date-time"
    },
    "reviewer": {
      "type": "string"
    },
    "certificateLevel": {
      "type": "string",
      "enum": ["Enterprise Platform", "Certified Platform", "Provisional Platform", "Experimental Platform"],
      "description": "Platform certification level."
    }
  }
}
