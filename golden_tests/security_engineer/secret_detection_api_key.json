{
  "test_id": "SE-GT-002",
  "name": "Deteksi Hardcoded API Key",
  "category": "secret_detection",
  "inputs": {
    "target_type": "code",
    "source_code": "API_KEY = \"sk-abc123def456ghi789jkl012mno345pqr678\"\nSECRET_TOKEN = \"ghp_ABCDEFGHIJKLMNOPQRSTUVWXYZabcdef\"",
    "language": "python",
    "standards": ["owasp_top10", "soc2"],
    "check_secrets": true,
    "include_remediation": true
  },
  "expected_output": {
    "secrets_found_min": 2,
    "api_key_type_required": true,
    "token_type_required": true,
    "remediation_required": true,
    "confidence_min": 0.85
  },
  "acceptance_criteria": [
    "Minimal 2 secret terdeteksi",
    "Satu berjenis api_key, satu berjenis token",
    "Location berisi file dan line number",
    "Remediation merekomendasikan secrets manager",
    "Severity ditetapkan sebagai 'critical' atau 'high'"
  ],
  "edge_cases": [
    "Secret dalam comment (seharusnya tetap terdeteksi)",
    "Secret dalam environment variable (seharusnya tidak di-flag)",
    "Fake/example secret yang terlihat real"
  ],
  "negative_cases": [
    "Secret tidak terdeteksi (false negative)",
    "Remediation tanpa referensi secrets manager",
    "Confidence score < 0.85 untuk secret yang jelas"
  ]
}
