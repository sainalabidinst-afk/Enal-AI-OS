{
    "test_id": "translator-007",
    "name": "Multi-sentence Context Preservation",
    "category": "context_preservation",
    "source_language": "en",
    "target_language": "es",
    "style": "formal",
    "domain": "general",
    "inputs": {
        "text": "First, we initialize the system. Then, we deploy the application. Finally, we monitor the services. The system is now operational.",
        "glossary_domain": "general",
