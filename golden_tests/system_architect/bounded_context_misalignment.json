{
  "test_id": "SA-GT-004",
  "name": "Ketidakselarasan Bounded Context DDD",
  "category": "ddd_analysis",
  "inputs": {
    "target_type": "architecture",
    "workspace_path": "/project/example_ddd_contexts",
    "architecture_style": "ddd",
    "focus_areas": ["maintainability", "testability"],
    "include_recommendations": true
  },
  "expected_output": {
    "ddd_issues_found": true,
    "bounded_contexts_identified_min": 2,
    "recommendation_required": true
  },
  "acceptance_criteria": [
    "Bounded contexts teridentifikasi dan dilaporkan",
    "Pelanggaran bounded context terdeteksi (shared kernel, inappropriate intimacy)",
    "Aggregate boundaries dianalisis",
    "Anti-corruption layer direkomendasikan jika diperlukan",
    "Domain events teridentifikasi"
  ],
  "edge_cases": [
    "Bounded context yang tumpang tindih",
    "Shared kernel yang terlalu besar",
    "Context tanpa aggregate yang jelas"
  ],
  "negative_cases": [
    "Bounded context tidak teridentifikasi (false negative)",
    "Anti-corruption layer direkomendasikan tanpa alasan",
    "Mengabaikan context map"
  ]
}
