{
  "test_id": "SA-GT-009",
  "name": "Identifikasi Bottleneck Skalabilitas",
  "category": "scalability_analysis",
  "inputs": {
    "target_type": "architecture",
    "workspace_path": "/project/example_scalability_issues",
    "architecture_style": "microservices",
    "focus_areas": ["scalability", "performance"],
    "include_recommendations": true
  },
  "expected_output": {
    "bottlenecks_found_min": 2,
    "bottleneck_priority_required": true,
    "horizontal_scaling_recommendation_required": true
  },
  "acceptance_criteria": [
    "Minimal 2 bottleneck skalabilitas teridentifikasi",
    "Bottleneck dikategorikan (CPU, memory, I/O, network, database)",
    "QPS/database connection/size metrics dipertimbangkan",
    "Rekomendasi horizontal vs vertical scaling diberikan",
    "Impact analysis untuk setiap bottleneck"
  ],
  "edge_cases": [
    "Bottleneck tersembunyi di dependency eksternal",
    "Bottleneck hanya muncul di peak load",
    "Multiple bottlenecks saling memperburuk"
  ],
  "negative_cases": [
    "Tidak ada bottleneck terdeteksi (false negative)",
    "Rekomendasi tanpa measurement yang jelas",
    "Mengabaikan bottleneck di shared state"
  ]
}
