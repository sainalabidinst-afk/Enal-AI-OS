                {"name": "brain-computer-interface", "description": "Direct neural interfaces", "maturity_level": "experimental"}
            ],
            "competitors": [
                {"name": "TechCorp", "market_share": 0.35, "strengths": ["R&D budget", "talent"], "weaknesses": ["slow adoption"]},
                {"name": "StartupXYZ", "market_share": 0.12, "strengths": ["agility", "innovation"], "weaknesses": ["limited capital"]}
            ],
            "historical_trends": {
                "agi": [
                    {"timestamp": "2024", "value": 0.1, "source": "industry_report"},
                    {"timestamp": "2025", "value": 0.25, "source": "industry_report"},
                    {"timestamp": "2026", "value": 0.45, "source": "industry_report"}
