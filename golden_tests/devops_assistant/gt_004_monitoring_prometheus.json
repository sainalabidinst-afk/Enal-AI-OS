{
  "test_id": "devops_assistant_gt_004",
  "name": "Konfigurasi Monitoring - Prometheus + Grafana",
  "category": "monitoring",
  "inputs": {
    "service_name": "payment-service",
    "stack": "prometheus",
    "metrics": ["request_latency", "error_rate", "throughput", "cpu_usage", "memory_usage"],
    "alert_thresholds": {
      "error_rate": 0.05,
      "request_latency_p99": 500
    }
  },
  "expected_output": {
    "monitoring_config_valid": true,
    "metrics_count": 5,
    "alerts_configured": 2,
    "dashboards_generated": true,
    "runbooks_referenced": true
  },
  "acceptance_criteria": [
    "Minimal 5 metrics terdefinisi",
    "Alert untuk error_rate dan latency",
    "Dashboard JSON dihasilkan"
  ],
  "edge_cases": [
    "Service dengan custom metrics",
    "Multi-service correlation"
  ],
  "negative_cases": [
    "Metrics kosong",
    "Threshold yang tidak valid"
  ]
}