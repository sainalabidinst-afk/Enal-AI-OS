  "acceptance_criteria": [
    "Functional specification dihasilkan",
    "API endpoints dijelaskan (POST /payment, GET /payment/{id})",
    "Request/Response schema ditentukan",
    "Error handling ditentukan (400, 401, 500, timeout)",
    "Authentication/authorization mechanism dijelaskan",
    "Non-functional requirements: latency, throughput, availability"
  ],
  "edge_cases": [
    "API dengan idempotency requirement",
    "API dengan retry mechanism",
    "API dengan webhook retry untuk merchant yang down"
