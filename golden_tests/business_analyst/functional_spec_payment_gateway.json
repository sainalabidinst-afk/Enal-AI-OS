{
  "test_id": "BA-GT-007",
  "name": "Functional Specification untuk API Pembayaran",
  "category": "functional_specification",
  "inputs": {
    "request_id": "ba-gt-007",
    "operation": "functional_spec",
    "business_context": {
      "domain": "fintech",
      "project_name": "Payment Gateway Integration"
    },
    "inputs": {
      "natural_language_requirements": [
        "API harus menerima payment request dari merchant",
