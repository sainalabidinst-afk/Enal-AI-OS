        "API harus menyendirkan webhook ke merchant"
      ],
      "technical_constraints": ["HTTPS only", "Response time < 500ms", "99.9% uptime"]
    }
  },
  "expected_output": {
    "functional_spec_required": true,
    "api_endpoints_specified": true,
    "request_response_schema_required": true,
    "error_handling_specified": true
