# AI OS Core Configuration
PROJECT_NAME=Enal AI OS
VERSION=1.0.0-dev
API_V1_STR=/api/v1

# Database
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enal_ai_os

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# MinIO Object Storage
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=enal
MINIO_SECURE=false

# Kafka Message Broker
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# LLM Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio

# LiteLLM Proxy (optional — required for production benchmark runtime)
LITELLM_MASTER_KEY=

# Model Configuration
DEFAULT_MODEL=lmstudio/qwen/qwen3.5-9b
DEFAULT_REASONING_MODEL=lmstudio/qwen/qwen3.5-9b
DEFAULT_EMBEDDING_MODEL=lmstudio/text-embedding-nomic-embed-text-v1.5

# Model Parameters
MAX_TOKENS=4096
TEMPERATURE=0.7

# Security
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=enal-ai-os

LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=http://localhost:3000

# Logging (JSON format for production log aggregation)
LOG_LEVEL=INFO
LOG_FORMAT=json
LOGGING_PROVIDER=console
