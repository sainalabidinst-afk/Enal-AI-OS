# AI OS Core Configuration
PROJECT_NAME=Enal AI OS
VERSION=0.1.0
API_V1_STR=/api/v1

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enal_ai_os

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# LLM Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Model Configuration
DEFAULT_MODEL=gpt-4o
DEFAULT_REASONING_MODEL=claude-3-5-sonnet-20240620
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# Model Parameters
MAX_TOKENS=4096
TEMPERATURE=0.7

# Security
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=enal-ai-os

LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=http://localhost:3000
